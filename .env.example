APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Biarkan false. Akun demo panel sudah otomatis mati di APP_ENV=production.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Di produksi: set SESSION_SECURE_COOKIE=true (wajib, cookie hanya via HTTPS).
# Bila dikosongkan, default otomatis true saat APP_ENV=production.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Panel admin (prefix rahasia + allowlist IP, kosongkan untuk menonaktifkan allowlist)
# ADMIN_PATH hanya dipakai untuk mengalihkan tautan lama ke /superadmin/*.
ADMIN_PATH=admin-mitrakerjasama
ADMIN_ALLOWED_IPS=

# Prefix panel per peran
SUPERADMIN_PATH=superadmin
ADMIN_KERJASAMA_PATH=admin-kerjasama

# Kredensial panel per peran.
# PENTING: isi PASSWORD_HASH dengan hash bcrypt, BUKAN password plaintext.
#   php -r "echo password_hash('kata-sandi-anda', PASSWORD_BCRYPT), PHP_EOL;"
# Kredensial superadmin, admin_kerjasama, dan admin_konten WAJIB berbeda.
# Akun dianggap mati (login ditutup) bila USERNAME atau PASSWORD_HASH kosong.
#
# KOSONG = PAKAI AKUN DEMO. Bila dibiarkan kosong dan APP_ENV bukan production,
# login memakai akun demo dari config/admin_akses.php (ikut ter-commit, jadi
# langsung bisa dipakai di mesin mana pun):
#   Superadmin      -> /superadmin/login        superadmin   / superadmin123
#   Admin Kerja Sama-> /admin-kerjasama/login   kerjasama    / kerjasama123
#   Admin Konten    -> /admin-konten/login      konten       / konten123
#   Developer       -> /superadmin/login        developer    / developer123
# Isi nilai di bawah untuk memakai akun sendiri; nilai .env menang.
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=

ADMIN_KERJASAMA_NAME="Admin Kerja Sama"
ADMIN_KERJASAMA_USERNAME=
ADMIN_KERJASAMA_EMAIL=
ADMIN_KERJASAMA_PASSWORD_HASH=

# Prefix panel Admin Konten (satu tingkat di bawah admin_kerjasama)
ADMIN_KONTEN_PATH=admin-konten

# Kredensial Admin Konten (hash bcrypt, tanpa plaintext di kode)
ADMIN_KONTEN_NAME="Admin Konten"
ADMIN_KONTEN_USERNAME=
ADMIN_KONTEN_EMAIL=
ADMIN_KONTEN_PASSWORD_HASH=

# Akun internal untuk /test-email (hanya tersedia saat APP_ENV=local)
DEVELOPER_NAME="Developer"
DEVELOPER_USERNAME=
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD_HASH=

# Gateway WhatsApp (biarkan kosong untuk menonaktifkan pengiriman nyata)
WA_GATEWAY_URL=
WA_GATEWAY_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
